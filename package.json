{
  "name": "trizo-horus",
  "version": "0.1.0",
  "description": "Multi-agent, multi-LLM-provider CLI that scans repositories and generates cross-repo user-journey data for the user-journey-finder viewer.",
  "type": "module",
  "bin": {
    "trizo-horus": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
